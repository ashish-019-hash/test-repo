# Azure OpenAI configuration for doc-extractor.
# Copy this file to .env and fill in the values. .env is git-ignored.
# When any of the five values is empty, the pipeline falls back to the
# deterministic rule-based provider (LLM_PROVIDER=rules) and logs a warning.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=
AZURE_OPENAI_MODEL=
AZURE_OPENAI_DEPLOYMENT=

# Optional: force a provider. One of auto | azure | rules | mock. Default: auto
# LLM_PROVIDER=auto

# Optional: LangSmith tracing passthrough (LangGraph reads these directly)
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=doc-extractor
